BEGIN:EFFECT
	NAME:"SNOW"
	TEXTURE_SLOT:"TEXTURE_SLOT_DUST"
	LIFE:(1.4)
	GRAVITY:0.0

	START_COLOUR:(255,255,255,0)
	END_COLOUR:(255,255,255,125)

	START_SIZE:(0.238):(0.238):(0.238)
	END_SIZE:(0.651):(0.991):(1.537)

	SPREAD:2.8
	RATE:40

	//
	// Animation Options
	//

	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	GROWTH:PARTICLE_ANIM_SIN_RAMP_SUSTAIN
	FADE:PARTICLE_ANIM_SQUARE_UP_DOWN_20
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_BASE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

