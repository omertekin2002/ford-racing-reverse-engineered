BEGIN:EFFECT
	NAME:"STREAM"
	TEXTURE_SLOT:"TEXTURE_SLOT_STREAM"
	LIFE:(0.5)
	GRAVITY:25.0

	START_SIZE:(0.5):(0.3)
	END_SIZE:(1.5):(2.0)

	START_COLOUR:(148,145,145,128):(188,180,180,128)
	END_COLOUR:(0,0,0,0):(0,0,0,0)

	SPREAD:5
	RATE:15

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_LINEAR_UP
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_LINEAR_UP
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_BASE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

