BEGIN:EFFECT
	NAME:"GRAVEL"
	TEXTURE_SLOT:"TEXTURE_SLOT_DUST"
	LIFE:(0.5)
	GRAVITY:9.81

	START_SIZE:(20)
	END_SIZE:(20)

	START_COLOUR:(82,155,71,100)	// Note that the colour components get overridden in wheeleff.c (alpha doesn't)
	END_COLOUR:(82,155,71,0)		// Note that the colour components get overridden in wheeleff.c (alpha doesn't)

	SPREAD:0			// gets overridden by the app
	RATE:0			// gets overridden by the app

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_NONE
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_SIN_HS
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_BASE
	ROLL:FALSE

	//
	// Physics Flags
	//

	BOUNCE:TRUE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

