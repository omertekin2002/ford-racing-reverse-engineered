BEGIN:EFFECT
	NAME:"MIST"
//	TEXTURE_SLOT:"TEXTURE_SLOT_WATERFALL_SPRAY"
	TEXTURE_SLOT:"TEXTURE_SLOT_DUST"
	LIFE:(2.2)
	GRAVITY:0.0

	START_SIZE:(5)
	END_SIZE:(5)

	START_COLOUR:(200,200,200,0)
	END_COLOUR:(200,200,200,100)

	SPREAD:180
	RATE:8

	FADE_DISTANCE:50
	UPDATE_RADIUS:200

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_NONE
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_SIN
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

