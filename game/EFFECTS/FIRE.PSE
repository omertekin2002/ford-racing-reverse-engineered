BEGIN:EFFECT
	NAME:"FIRE"
	TEXTURE_SLOT:"TEXTURE_SLOT_FIRE"
	LIFE:(1.4)
	GRAVITY:0.0

	START_SIZE:(0.5):(0.5):(0.5)
	END_SIZE:(1.8):(2.0):(1.5)

	START_COLOUR:(255,204,51,0):(255,204,51,0)
	END_COLOUR:(223,169,6,100):(202,80,32,100)

	SPREAD:20
	RATE:15

	UPDATE_RADIUS:250

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_SQUARE_UP_DOWN_20
	COLOUR_CHANGE:PARTICLE_ANIM_SIN_RAMP_SUSTAIN
//	COLOUR_CHANGE:PARTICLE_ANIM_LINEAR_UP
	FADE:PARTICLE_ANIM_SQUARE_UP_DOWN_20
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:TRUE
	ZWRITE:FALSE
END:EFFECT

