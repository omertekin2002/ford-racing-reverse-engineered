BEGIN:EFFECT
	NAME:"BLACK_SMOKE"
	TEXTURE_SLOT:"TEXTURE_SLOT_BLACK_SMOKE"
	LIFE:(1.6)
	GRAVITY:0.0

	START_SIZE:(20)
	END_SIZE:(20)

	START_COLOUR:(222,212,148,128)
	END_COLOUR:(0,0,0,128)

	SPREAD:0			// gets overridden by the app
	RATE:0			// gets overridden by the app

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_LINEAR_UP
	COLOUR_CHANGE:PARTICLE_ANIM_LINEAR_UP
	FADE:PARTICLE_ANIM_SIN_HS
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:TRUE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

