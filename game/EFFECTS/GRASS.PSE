BEGIN:EFFECT
	NAME:"GRASS"
	TEXTURE_SLOT:"TEXTURE_SLOT_GRASS"
	LIFE:(0.9)
	GRAVITY:9.81

	START_SIZE:(0.3):(0.3)
	END_SIZE:(0.3):(0.3)

	START_COLOUR:(0,0,0,100)	// Note that the colour components get overridden in wheeleff.c (alpha doesn't)
	END_COLOUR:(0,0,0,0)			// Note that the colour components get overridden in wheeleff.c (alpha doesn't)

	SPREAD:10
	RATE:30

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_NONE
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_SQUARE_UP_ACC
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_BASE
	ROLL:FALSE

	//
	// Physics Flags
	//

	BOUNCE:TRUE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:TRUE
	ZWRITE:FALSE
END:EFFECT

