BEGIN:EFFECT
	NAME:"TYRE"
	TEXTURE_SLOT:"TEXTURE_SLOT_TYRE_SMOKE"
	LIFE:(2.0)
	GRAVITY:0.0

	START_SIZE:(20)
	END_SIZE:(20)

	START_COLOUR:(255,255,255,96)
	END_COLOUR:(255,255,255,96)

	SPREAD:0			// gets overridden by the app
	RATE:0			// gets overridden by the app

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_SQUARE_UP_DEC
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_SQUARE_UP_DOWN_20
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_BASE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:TRUE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

