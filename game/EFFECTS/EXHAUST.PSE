BEGIN:EFFECT
	NAME:"EXHAUST"
	TEXTURE_SLOT:"TEXTURE_SLOT_EXHAUST"
	LIFE:(0.4)
	GRAVITY:0.0

	START_SIZE:(0.4)
	END_SIZE:(1.0)

	START_COLOUR:(160,160,160,16)
	END_COLOUR:(255,255,255,16)

	SPREAD:0			// Gets overridden by the app
	RATE:0			// Gets overridden by the app

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_LINEAR_UP
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_SIN_HS
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:TRUE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

