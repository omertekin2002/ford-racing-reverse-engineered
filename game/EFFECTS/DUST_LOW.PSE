	NAME:"DUST_LOW"
	TEXTURE_SLOT:"TEXTURE_SLOT_DUST"
	LIFE:(0.4)
	GRAVITY:0.0

	START_SIZE:(0.0):(0.0):(0.0)
	END_SIZE:(0.5):(1.5):(3.0)

	START_COLOUR:(222,212,148,120):(219,202,103,120):(231,227,181,120)
	END_COLOUR:(47,47,47,120):(47,47,47,120):(47,47,47,120)

