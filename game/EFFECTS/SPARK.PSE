BEGIN:EFFECT
	NAME:"SPARK"
	TEXTURE_SLOT:"TEXTURE_SLOT_SPARK"
	LIFE:(0.4)
	GRAVITY:9.8

	START_SIZE:(20)
	END_SIZE:(20)

	START_COLOUR:(216,184,120,255)
	END_COLOUR:(42,0,0,255)

	SPREAD:0			// gets overridden by the app
	RATE:0			// gets overridden by the app

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_SQUARE_DOWN
	COLOUR_CHANGE:PARTICLE_ANIM_LINEAR_UP
	FADE:PARTICLE_ANIM_NONE
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:FALSE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:TRUE

	//
	// Render Flags
	//

	ADDITIVE:TRUE
	ZWRITE:FALSE
END:EFFECT

