BEGIN:EFFECT
	NAME:"SNOW_LOW"
	TEXTURE_SLOT:"TEXTURE_SLOT_DUST"
	LIFE:(0.2)
	GRAVITY:0.0

	START_COLOUR:(255,255,255,0)
	END_COLOUR:(255,255,255,120)

	START_SIZE:(0.138):(0.138):(0.138)
	END_SIZE:(0.651):(0.391):(0.537)

	SPREAD:10
	RATE:25

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_LINEAR_UP
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_SQUARE_UP_DOWN_20
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_BASE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:TRUE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

