BEGIN:EFFECT
	NAME:"BARN_ON_FIRE_INSIDE_FLAMES"
	TEXTURE_SLOT:"TEXTURE_SLOT_FIRE"
	LIFE:(1.4)
	GRAVITY:0.0

	START_SIZE:(0.5):(0.5):(0.5)
	END_SIZE:(2.8):(3.0):(2.5)

	START_COLOUR:(255,191,0,0)
	END_COLOUR:(255,120,0,140)

	SPREAD:20
	RATE:0

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_SQUARE_UP_DOWN_20
	COLOUR_CHANGE:PARTICLE_ANIM_SIN_RAMP_SUSTAIN
//	COLOUR_CHANGE:PARTICLE_ANIM_LINEAR_UP
	FADE:PARTICLE_ANIM_SQUARE_UP_DOWN_20
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:TRUE
	ZWRITE:FALSE
END:EFFECT

