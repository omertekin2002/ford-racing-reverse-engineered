BEGIN:EFFECT
	NAME:"BOOST"
	TEXTURE_SLOT:"TEXTURE_SLOT_BOOST"
	LIFE:(0.05)
	GRAVITY:0.0

	//
	// Sizes are set in code
	//

	START_SIZE:(0.0)
	END_SIZE:(0.0)

	//
	// Colours are set in code
	//

	START_COLOUR:(0,0,0,0)
	END_COLOUR:(0,0,0,0)

	SPREAD:0.0
	RATE:650

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_SQUARE_UP_DEC
	COLOUR_CHANGE:PARTICLE_ANIM_SQUARE_UP_DEC
	FADE:PARTICLE_ANIM_LINEAR_UP
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:FALSE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:TRUE
	ZWRITE:FALSE
END:EFFECT

