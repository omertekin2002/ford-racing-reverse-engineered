BEGIN:EFFECT
	NAME:"SPRAY"
	TEXTURE_SLOT:"TEXTURE_SLOT_SPRAY"
	LIFE:(2.2)
//	GRAVITY:12.81
	GRAVITY:0.0

	START_SIZE:(5)
	END_SIZE:(5)

	SPREAD:40
	RATE:4

	START_COLOUR:(200,200,200,0)
	END_COLOUR:(200,200,200,150)

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_NONE
	COLOUR_CHANGE:PARTICLE_ANIM_NONE
	FADE:PARTICLE_ANIM_SQUARE_UP_DOWN_20
