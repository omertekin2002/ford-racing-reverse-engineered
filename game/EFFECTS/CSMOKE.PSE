BEGIN:EFFECT
	NAME:"INDUSTRIAL_CHIMNEY_SMOKE"
	TEXTURE_SLOT:"TEXTURE_SLOT_DUST"
	LIFE:(6.0)
	GRAVITY:0.0

	START_SIZE:(0):(0):(0)
	END_SIZE:(6):(7):(8)

	START_COLOUR:(90,90,90,200)
	END_COLOUR:(140,140,140,0)

	SPREAD:15
	RATE:3

	//
	// Animation Options
	//

	GROWTH:PARTICLE_ANIM_SQUARE_UP_20
	COLOUR_CHANGE:PARTICLE_ANIM_LINEAR_UP
	FADE:PARTICLE_ANIM_SQUARE_UP_ACC
	GROWTH_ORIGIN:PARTICLE_GROWTH_ORIGIN_CENTRE
	ROLL:TRUE

	//
	// Physics Flags
	//

	BOUNCE:FALSE
	DRAG:FALSE

	//
	// Render Flags
	//

	ADDITIVE:FALSE
	ZWRITE:FALSE
END:EFFECT

