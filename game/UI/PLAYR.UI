	:POSITION_END 							0.37813 0.60833

	// DONE
	:INHERIT									BACK_ICON
	:POSITION_END 							0.40938 0.86875
	:POSITION_START 						0.40938 0.86875

	:INHERIT									BACK_TEXT
	:POSITION_START 						0.45313 0.88
	:POSITION_END 							0.45313 0.88
	:TEXT_JUSTIFY							4
		
	//////////////////////////////////////////////////////
	//
	//////////////////////////////////////////////////////

